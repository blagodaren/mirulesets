# Copy to .env. Set a unique password of at least 12 characters.
MI_ADMIN_PASSWORD=
# Optional API bearer token; at least 32 characters when set.
MI_API_TOKEN=
# Optional read-only /metrics token: at least 32 characters, distinct from MI_API_TOKEN.
MI_METRICS_TOKEN=
# Optional declarative YAML/JSON file, atomically merged at startup.
# Mount it into the container separately when using Docker.
MI_RULESETS_FILE=

# Optional JSON webhook for build failures. Delivery timeout: 5 seconds.
MI_ALERT_WEBHOOK_URL=
# Optional Authorization: Bearer credential for the webhook receiver.
MI_ALERT_WEBHOOK_TOKEN=

# Only if a trusted local Mihomo TUN uses fake-IP DNS:
# MI_SOURCE_ALLOWED_CIDRS=198.18.0.0/15
MI_PUBLIC_URL=http://localhost:8080
# Optional: comma-separated CIDRs of the reverse proxies that connect to the app.
# Native app + local proxy: 127.0.0.1/32,::1/128.
# Docker: use the actual proxy-network subnet or exact trusted proxy IP /32.
# Leave empty for direct access. Never use 0.0.0.0/0 or ::/0.
# External HTTPS with MI_TLS_MODE=off warns at startup if this is empty:
# clients behind one proxy share an IP and login lockout. Trust only your proxy.
MI_TRUSTED_PROXIES=

# Automatic TLS: use compose.acme.yml and set both values.
MI_DOMAIN=
MI_ACME_EMAIL=

# Optional S3-compatible storage. Create the bucket beforehand.
# Endpoint may be host:port or a full http(s) URL without a path.
MI_S3_ENDPOINT=
MI_S3_REGION=us-east-1
MI_S3_BUCKET=
MI_S3_ACCESS_KEY=
MI_S3_SECRET_KEY=
MI_S3_SESSION_TOKEN=
MI_S3_PREFIX=rules
MI_S3_SECURE=true
MI_S3_PATH_STYLE=false
# Bucket-root public/CDN URL; leave empty for private buckets.
MI_S3_PUBLIC_URL=
